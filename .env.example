# ==============================================================================
# RO WATER PURIFIER SERVICE & RENEWAL ENGINE — PRODUCTION ENVIRONMENT CONFIG
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE MULTI-TENANT DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Client-side Supabase URL & Public Anon Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Server-only Service Role Secret (NEVER prefix with NEXT_PUBLIC_!)
# Used by autonomous scheduler cron, background workers, and webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Local Sandbox Toggle:
# Set to 'true' to isolate local testing with mock data.
# Set to 'false' in staging/production to connect live multi-tenant PostgreSQL.
NEXT_PUBLIC_LOCAL_SANDBOX=false

# ------------------------------------------------------------------------------
# 2. META WHATSAPP CLOUD API CONFIGURATION
# ------------------------------------------------------------------------------
# Mode: 'production' to dispatch to Meta Cloud API, 'mock' for sandbox simulation
WHATSAPP_MODE=production

# Meta Graph API Access Token (System User permanent token recommended)
WHATSAPP_ACCESS_TOKEN=EAAG...your_permanent_access_token

# WhatsApp Business Account (WABA) Phone Number ID from Meta App Dashboard
WHATSAPP_PHONE_NUMBER_ID=100000000000000

# Meta Webhook Verification Token (set this in Meta App Webhook settings)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ro_service_verify_token_2026

# Meta App Secret for HMAC-SHA256 signature verification (optional but recommended)
WHATSAPP_APP_SECRET=your_meta_app_secret

# ------------------------------------------------------------------------------
# 3. AUTONOMOUS SCHEDULER & CRON SECURITY
# ------------------------------------------------------------------------------
# Secret token to protect GET/POST /api/cron/reminders from unauthorized triggers
CRON_SECRET=your_high_entropy_cron_secret_phrase_2026

# Timezone for quiet-hours protection (default: Asia/Kolkata)
BUSINESS_TIMEZONE=Asia/Kolkata
